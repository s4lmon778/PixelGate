{
  "name": "speedgate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Lossless browser file transfers with optional local HTTP/TCP streaming and independent SHA-256 verification.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8787",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "bench:native": "node scripts/benchmark-native-transfer.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:lan": "node --experimental-strip-types scripts/serve-lan.mjs",
    "bench:http": "playwright test tests/browser/http-transfer.spec.ts --project=chromium",
    "bench:compare": "node --experimental-strip-types scripts/benchmark-http-transfer.mjs",
    "package:helper": "npm run build && node scripts/package-helper.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.31.0",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.19",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsqr": "1.4.0",
    "peer": "1.0.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "ws": "8.22.0"
  }
}
